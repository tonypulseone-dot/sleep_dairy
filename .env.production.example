# Скопируйте в .env рядом с docker-compose.yml и заполните.

# Домен, на который смотрит запись A вашего сервера.
APP_DOMAIN=sleep.example.ru

# Токен от @BotFather и имя бота без @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Пароль базы и секрет для подписи сессий — длинные случайные строки.
# Сгенерировать: openssl rand -hex 32
POSTGRES_PASSWORD=
SESSION_SECRET=

# Нужен только для разбора скриншотов дневника. Без него приложение
# работает, а загрузка снимками честно говорит, что не настроена.
ANTHROPIC_API_KEY=

# Реквизиты оператора персональных данных для политики конфиденциальности.
# Без них страница /privacy открывается с предупреждением, что документ
# не заполнен: по 152-ФЗ политика без оператора и контакта силы не имеет.
LEGAL_OPERATOR=ИП Иванов Иван Иванович
LEGAL_INN=000000000000
LEGAL_EMAIL=privacy@example.ru
LEGAL_HOSTING=Selectel, дата-центр в Санкт-Петербурге
