{
  "name": "sleep-diary",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:runtime": "esbuild migrate=src/db/migrate.ts bot=src/bot/index.ts seed-norms=scripts/seed-norms.ts seed-activities=scripts/seed-activities.ts seed-consultant=scripts/seed-consultant.ts --bundle --platform=node --target=node22 --format=cjs --outdir=runtime --out-extension:.js=.cjs --external:pg-native --log-level=warning",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test src/**/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed:consultant": "tsx --env-file=.env.local scripts/seed-consultant.ts",
    "seed:demo": "tsx --env-file=.env.local scripts/seed-demo-diary.ts",
    "seed:norms": "tsx --env-file=.env.local scripts/seed-norms.ts",
    "seed:activities": "tsx --env-file=.env.local scripts/seed-activities.ts",
    "bot": "tsx --env-file=.env.local src/bot/index.ts",
    "bot:prod": "tsx src/bot/index.ts",
    "db:apply": "tsx --env-file=.env.local src/db/migrate.ts",
    "db:apply:prod": "node --experimental-strip-types src/db/migrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@telegram-apps/sdk-react": "^3.3.9",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.46.0",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
